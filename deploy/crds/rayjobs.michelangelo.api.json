{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "rayjobs.michelangelo.api"
  },
  "spec": {
    "conversion": {
      "strategy": "None"
    },
    "group": "michelangelo.api",
    "names": {
      "kind": "RayJob",
      "listKind": "RayJobList",
      "plural": "rayjobs",
      "singular": "rayjob"
    },
    "scope": "Namespaced",
    "versions": [
      {
        "name": "v2",
        "schema": {
          "openAPIV3Schema": {
            "properties": {
              "spec": {
                "properties": {
                  "cluster": {
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "namespace": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "entrypoint": {
                    "type": "string"
                  },
                  "jobId": {
                    "type": "string"
                  },
                  "objectStoreMemoryRatio": {
                    "format": "double",
                    "type": "number"
                  },
                  "user": {
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "proxyUser": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "status": {
                "properties": {
                  "dashboardUrl": {
                    "type": "string"
                  },
                  "jobDeploymentStatus": {
                    "type": "string"
                  },
                  "jobId": {
                    "type": "string"
                  },
                  "jobStatus": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "rayClusterName": {
                    "type": "string"
                  },
                  "state": {
                    "enum": [
                      "RAY_JOB_STATE_INVALID",
                      "RAY_JOB_STATE_INITIALIZING",
                      "RAY_JOB_STATE_RUNNING",
                      "RAY_JOB_STATE_SUCCEEDED",
                      "RAY_JOB_STATE_FAILED",
                      "RAY_JOB_STATE_KILLED"
                    ],
                    "type": "string"
                  },
                  "statusConditions": {
                    "items": {
                      "properties": {
                        "lastUpdatedTimestamp": {
                          "format": "int64",
                          "pattern": "^[-]?\\d{1,19}$",
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "metadata": {
                          "properties": {
                            "@type": {
                              "description": "A URL/resource name that uniquely identifies the type of the serialized protocol buffer message.",
                              "type": "string"
                            },
                            "value": {
                              "description": "Serialized data of the above type.",
                              "format": "byte",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "observedGeneration": {
                          "format": "int64",
                          "pattern": "^[-]?\\d{1,19}$",
                          "type": "string"
                        },
                        "reason": {
                          "type": "string"
                        },
                        "status": {
                          "enum": [
                            "CONDITION_STATUS_UNKNOWN",
                            "CONDITION_STATUS_TRUE",
                            "CONDITION_STATUS_FALSE"
                          ],
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        }
      }
    ]
  }
}
